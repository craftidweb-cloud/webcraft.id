# Dockerfile for running this PHP site with FrankenPHP + Caddy.
# Note: this is for Docker/VPS/container hosting, not Vercel's native PHP runtime.
FROM dunglas/frankenphp:1-php8.3

WORKDIR /app
COPY . /app

# Caddy serves the site on port 80.
EXPOSE 80

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
